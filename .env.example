# Bu dosyayi ".env" olarak kopyala ve kendi anahtarini yaz.
# .env dosyasi ASLA git'e / paylasima girmez.
#
# Anahtari buradan al: https://aistudio.google.com/apikey
# Gecerli bir Gemini API anahtari "AIza..." ile baslar.
GEMINI_API_KEY=AIza...

# Streamlit Cloud'a deploy ederken .env yuklenmez!
# Orada: uygulama sayfasi -> Manage app -> Settings -> Secrets
# icine su satiri yapistir:
#   gemini_api_key = "AIza..."

# --- Kalici depolama (Supabase) --------------------------------------
# Bunlar tanimliysa sohbetler, yuklenen dosyalar ve aktif testler bulutta
# saklanir: uygulama yeniden baslasa da silinmez ve ayni linke giren herkes
# (farkli cihazlardan da) ayni veriyi gorur. Tanimli degilse uygulama
# eskisi gibi yerel dosyalarla calisir (veri restart'ta silinir).
# Kurulum adimlari: supabase_kurulum.sql dosyasinin basinda yazili.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=eyJhbGciOi...
#
# Streamlit Cloud Secrets karsiligi:
#   supabase_url = "https://xxxx.supabase.co"
#   supabase_key = "eyJhbGciOi..."
