# Bu dosyayi ".env" olarak kopyala ve kendi anahtarini yaz.
# .env dosyasi ASLA git'e / paylasima girmez.
#
# Anahtari buradan al: https://aistudio.google.com/apikey
# Gecerli bir Gemini API anahtari "AIza..." ile baslar.
GEMINI_API_KEY=AIza...

# Streamlit Cloud'a deploy ederken .env yuklenmez!
# Orada: uygulama sayfasi -> Manage app -> Settings -> Secrets
# icine su satiri yapistir:
#   gemini_api_key = "AIza..."
